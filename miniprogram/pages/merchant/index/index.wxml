<view class="page">
  <view class="shop-header">
    <text class="shop-name">{{merchant.name}}</text>
    <text class="shop-area">{{merchant.area}}</text>
  </view>
  <view class="stats">
    <view class="stat"><text class="stat-num">{{dashboard.today.count}}</text><text class="stat-label">今日订单</text></view>
    <view class="stat"><text class="stat-num">¥{{dashboard.today.amount}}</text><text class="stat-label">今日收入</text></view>
    <view class="stat"><text class="stat-num">{{dashboard.pendingOrders}}</text><text class="stat-label">待接单</text></view>
    <view class="stat"><text class="stat-num">{{dashboard.activeProducts}}</text><text class="stat-label">在售商品</text></view>
  </view>
  <view class="menu">
    <view class="menu-item" bindtap="goToOrders"><text class="mi-icon">📋</text><text class="mi-text">订单管理</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goToProducts"><text class="mi-icon">🍜</text><text class="mi-text">商品管理</text><text class="mi-arrow">›</text></view>
  </view>
</view>
