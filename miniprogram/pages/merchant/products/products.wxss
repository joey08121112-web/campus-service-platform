.page{min-height:100vh;background:#f5f5f7}.add-bar{padding:20rpx 24rpx}.add-btn{background:#0071e3;color:#fff;border-radius:12rpx;padding:20rpx;text-align:center;font-size:28rpx;font-weight:600}.add-btn:active{background:#0077ed}.list{padding:0 24rpx}.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}.card-top{display:flex;align-items:center;margin-bottom:16rpx}.card-img{width:80rpx;height:80rpx;border-radius:12rpx;background:#e8e8ed;display:flex;align-items:center;justify-content:center;font-size:36rpx;flex-shrink:0}.card-info{flex:1;margin-left:20rpx}.card-name{display:block;font-size:30rpx;font-weight:600;color:#1d1d1f}.card-price{display:block;font-size:28rpx;color:#ff3b30;font-weight:600;margin-top:4rpx}.card-stock{display:block;font-size:22rpx;color:#86868b;margin-top:2rpx}.status-badge{padding:8rpx 20rpx;border-radius:8rpx;font-size:22rpx;font-weight:500}.status-badge.on{background:#e8f5e9;color:#34c759}.status-badge.off{background:#ffebee;color:#ff3b30}.card-actions{display:flex;gap:16rpx;padding-top:16rpx;border-top:1rpx solid #d2d2d7}.act-btn{flex:1;padding:14rpx;border-radius:10rpx;text-align:center;font-size:24rpx;background:#f5f5f7;color:#1d1d1f}.act-btn.del{color:#ff3b30}.empty{text-align:center;padding:120rpx 0;color:#86868b;font-size:28rpx}
