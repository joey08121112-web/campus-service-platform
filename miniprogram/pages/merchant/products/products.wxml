<view class="page">
  <view class="add-bar"><view class="add-btn" bindtap="addProduct"><text>+ 添加商品</text></view></view>
  <view class="list">
    <view class="card" wx:for="{{products}}" wx:key="id">
      <view class="card-top">
        <view class="card-img"><text>🍜</text></view>
        <view class="card-info">
          <text class="card-name">{{item.name}}</text>
          <text class="card-price">¥{{item.price}}</text>
          <text class="card-stock">库存: {{item.stock}}</text>
        </view>
        <view class="status-badge {{item.status===1?'on':'off'}}" bindtap="toggle" data-id="{{item.id}}"><text>{{item.status===1?'在售':'下架'}}</text></view>
      </view>
      <view class="card-actions">
        <view class="act-btn" bindtap="edit" data-id="{{item.id}}">编辑</view>
        <view class="act-btn del" bindtap="del" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{products.length===0}}"><text>暂无商品</text></view>
</view>
