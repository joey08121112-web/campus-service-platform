<view class="page">
  <view class="tabs">
    <view class="tab {{tab===''?'active':''}}" bindtap="switchTab" data-tab="">全部</view>
    <view class="tab {{tab==='1'?'active':''}}" bindtap="switchTab" data-tab="1">待接单</view>
    <view class="tab {{tab==='2'?'active':''}}" bindtap="switchTab" data-tab="2">备餐中</view>
    <view class="tab {{tab==='3'?'active':''}}" bindtap="switchTab" data-tab="3">配送中</view>
  </view>
  <view class="list">
    <view class="card" wx:for="{{orders}}" wx:key="id">
      <view class="card-head">
        <text class="order-no">#{{item.order_no}}</text>
        <text class="order-st {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="card-user"><text class="uname">{{item.user_name||'用户'}}</text><text class="uphone">{{item.user_phone}}</text></view>
      <view class="card-addr">📍 {{item.address}}</view>
      <view class="card-amt">¥{{item.total_amount}}</view>
      <view class="card-acts">
        <view class="act" wx:if="{{item.status===1}}" bindtap="accept" data-id="{{item.id}}">接单</view>
        <view class="act" wx:if="{{item.status===2}}" bindtap="deliver" data-id="{{item.id}}">配送</view>
        <view class="act green" wx:if="{{item.status===3}}" bindtap="complete" data-id="{{item.id}}">完成</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{orders.length===0}}"><text>暂无订单</text></view>
</view>
