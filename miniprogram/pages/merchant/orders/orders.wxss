.page{min-height:100vh;background:#f5f5f7}.tabs{display:flex;background:#fff;padding:16rpx 24rpx;gap:12rpx;border-bottom:1rpx solid #d2d2d7}.tab{padding:12rpx 28rpx;border-radius:980rpx;font-size:26rpx;color:#86868b;background:#e8e8ed;font-weight:500}.tab.active{background:#1d1d1f;color:#fff}.list{padding:20rpx 24rpx}.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}.order-no{font-size:26rpx;color:#86868b}.order-st{font-size:22rpx;padding:6rpx 16rpx;border-radius:8rpx;font-weight:500}.sp{background:#fff3e0;color:#ff9500}.sc{background:#e3f2fd;color:#0071e3}.sd{background:#e8f5e9;color:#34c759}.ss{background:#f5f5f7;color:#86868b}.card-user{display:flex;align-items:center;gap:12rpx;margin-bottom:8rpx}.uname{font-size:28rpx;font-weight:600;color:#1d1d1f}.uphone{font-size:24rpx;color:#86868b}.card-addr{font-size:26rpx;color:#1d1d1f;margin-bottom:8rpx}.card-amt{font-size:32rpx;font-weight:700;color:#1d1d1f;margin-bottom:16rpx}.card-acts{display:flex;gap:12rpx;padding-top:16rpx;border-top:1rpx solid #d2d2d7}.act{flex:1;padding:16rpx;border-radius:12rpx;text-align:center;font-size:26rpx;font-weight:600;background:#0071e3;color:#fff}.act:active{background:#0077ed}.act.green{background:#34c759}.empty{text-align:center;padding:120rpx 0;color:#86868b;font-size:28rpx}
