.page{min-height:100vh;background:#f5f5f7;padding:0 32rpx}.header{padding:120rpx 0 60rpx}.title{display:block;font-size:56rpx;font-weight:700;color:#1d1d1f}.subtitle{display:block;font-size:28rpx;color:#86868b;margin-top:12rpx}.form-card{background:#fff;border-radius:20rpx;overflow:hidden;margin-bottom:40rpx}.input-row{display:flex;align-items:center;padding:28rpx 32rpx;border-bottom:1rpx solid #d2d2d7}.input-row:last-child{border-bottom:none}.label{width:120rpx;font-size:30rpx;color:#1d1d1f;flex-shrink:0}.input{flex:1;font-size:30rpx;color:#1d1d1f}.btn{background:#0071e3;color:#fff;border-radius:16rpx;padding:28rpx;text-align:center;font-size:30rpx;font-weight:600}.btn:active{background:#0077ed}
