<view class="page">
  <view class="section-card">
    <view class="section-title"><text class="title-icon">📱</text><text>外卖信息</text></view>
    <view class="form-item">
      <text class="form-label">外卖平台</text>
      <picker bindchange="onPlatformChange" value="{{platformIndex}}" range="{{platforms}}">
        <view class="picker-btn"><text>{{selectedPlatform || '请选择平台'}}</text><text class="picker-arrow">›</text></view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">取餐码</text>
      <input class="form-input" placeholder="请输入取餐码" value="{{pickupCode}}" bindinput="onInput" data-field="pickupCode"/>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title"><text class="title-icon">📍</text><text>配送信息</text></view>
    <view class="form-item">
      <text class="form-label">取餐地点</text>
      <input class="form-input" placeholder="哪个校门/取餐点" value="{{pickupLocation}}" bindinput="onInput" data-field="pickupLocation"/>
    </view>
    <view class="form-item">
      <text class="form-label">配送到</text>
      <input class="form-input" placeholder="宿舍楼 + 房间号" value="{{destination}}" bindinput="onInput" data-field="destination"/>
    </view>
    <view class="form-item">
      <text class="form-label">手机尾号</text>
      <input class="form-input" placeholder="4位手机号尾号" type="number" maxlength="4" value="{{phoneTail}}" bindinput="onInput" data-field="phoneTail"/>
    </view>
    <view class="form-item">
      <text class="form-label">我的性别</text>
      <view class="gender-options">
        <view class="option {{gender === 'male' ? 'active' : ''}}" bindtap="setGender" data-gender="male">男</view>
        <view class="option {{gender === 'female' ? 'active' : ''}}" bindtap="setGender" data-gender="female">女</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title"><text class="title-icon">💰</text><text>配送费</text></view>
    <view class="fee-options">
      <view class="fee-item {{deliveryFee === 3 ? 'active' : ''}}" bindtap="setFee" data-fee="3">¥3</view>
      <view class="fee-item {{deliveryFee === 5 ? 'active' : ''}}" bindtap="setFee" data-fee="5">¥5</view>
      <view class="fee-item {{deliveryFee === 8 ? 'active' : ''}}" bindtap="setFee" data-fee="8">¥8</view>
      <view class="fee-item {{deliveryFee === 10 ? 'active' : ''}}" bindtap="setFee" data-fee="10">¥10</view>
    </view>
  </view>

  <view class="submit-btn" bindtap="submitOrder" hover-class="submit-btn-hover">
    <text>发布任务</text>
  </view>
</view>
