<view class="page">
  <view class="section-card">
    <view class="section-title"><text class="title-icon">📦</text><text>快递信息</text></view>
    <view class="form-item">
      <text class="form-label">快递类型</text>
      <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{expressTypes}}">
        <view class="picker-btn"><text>{{selectedType || '请选择快递类型'}}</text><text class="picker-arrow">›</text></view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">取件码</text>
      <input class="form-input" placeholder="请输入取件码或快递单号" value="{{trackingNo}}" bindinput="onInput" data-field="trackingNo"/>
    </view>
    <view class="form-item">
      <text class="form-label">包裹大小</text>
      <view class="size-options">
        <view class="option {{packageSize === 'small' ? 'active' : ''}}" bindtap="setSize" data-size="small">小件</view>
        <view class="option {{packageSize === 'medium' ? 'active' : ''}}" bindtap="setSize" data-size="medium">中件</view>
        <view class="option {{packageSize === 'large' ? 'active' : ''}}" bindtap="setSize" data-size="large">大件</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title"><text class="title-icon">📍</text><text>配送信息</text></view>
    <view class="form-item">
      <text class="form-label">配送到</text>
      <input class="form-input" placeholder="宿舍楼 + 房间号" value="{{destination}}" bindinput="onInput" data-field="destination"/>
    </view>
    <view class="form-item">
      <text class="form-label">手机尾号</text>
      <input class="form-input" placeholder="4位手机号尾号" type="number" maxlength="4" value="{{phoneTail}}" bindinput="onInput" data-field="phoneTail"/>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title"><text class="title-icon">💰</text><text>代取费用</text></view>
    <view class="fee-hint" wx:if="{{suggestedPrice > 0}}">
      <text>建议价格: <text class="fee-highlight">¥{{suggestedPrice}}</text></text>
    </view>
    <view class="fee-options">
      <view class="fee-item {{deliveryFee === item ? 'active' : ''}}" wx:for="{{feeOptions}}" wx:key="*this" bindtap="setFee" data-fee="{{item}}">¥{{item}}</view>
    </view>
  </view>

  <view class="submit-btn" bindtap="submitOrder" hover-class="submit-btn-hover">
    <text>发布任务</text>
  </view>
</view>
