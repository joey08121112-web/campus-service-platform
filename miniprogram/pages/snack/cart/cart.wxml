<view class="page">
  <view class="section-card">
    <view class="section-title">
      <text class="title-icon">🏠</text>
      <text>配送信息</text>
    </view>
    <view class="form-item">
      <text class="form-label">房间号</text>
      <input class="form-input" placeholder="请输入房间号" value="{{room}}" bindinput="onInput" data-field="room"/>
    </view>
    <view class="form-item">
      <text class="form-label">取货方式</text>
      <view class="pickup-options">
        <view class="option {{pickupType === 'self' ? 'active' : ''}}" bindtap="setPickup" data-type="self">自取</view>
        <view class="option {{pickupType === 'delivery' ? 'active' : ''}}" bindtap="setPickup" data-type="delivery">配送 (+¥1)</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">
      <text class="title-icon">🍪</text>
      <text>商品清单</text>
    </view>
    <view class="product-item" wx:for="{{items}}" wx:key="product_id">
      <view class="product-emoji">{{item.emoji}}</view>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-price">¥{{item.price}}</text>
      </view>
      <text class="product-quantity">x{{item.quantity}}</text>
      <text class="product-subtotal">¥{{item.subtotal}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="price-info">
      <text class="price-label">合计</text>
      <view class="price-row">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{totalAmount}}</text>
      </view>
    </view>
    <view class="submit-btn" bindtap="submitOrder" hover-class="submit-btn-hover">
      <text>提交订单</text>
    </view>
  </view>
</view>
