/* Apple Store 风格 - 个人中心 */

.page {
  min-height: 100vh;
  background: #f5f5f7;
}

/* 用户信息头部 */
.profile-header {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #0071e3, #00c7ff);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.3rpx;
}

.user-detail {
  display: block;
  font-size: 26rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.edit-link {
  font-size: 28rpx;
  color: #0066cc;
  font-weight: 500;
}

.edit-link:active {
  opacity: 0.7;
}

/* 列表组 */
.list-group {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.list-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #d2d2d7;
}

.list-row:last-child {
  border-bottom: none;
}

.list-row:active {
  background: #f5f5f7;
}

.row-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.list-row-content {
  flex: 1;
}

.list-row-label {
  font-size: 30rpx;
  color: #1d1d1f;
}

.list-row-arrow {
  color: #aeaeb2;
  font-size: 36rpx;
}

/* 退出按钮 */
.logout-btn {
  margin: 40rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.logout-text {
  font-size: 30rpx;
  color: #ff3b30;
  font-weight: 500;
}

.logout-btn:active {
  background: #fafafa;
}
