/* Apple Store 风格 - 商家列表 */

.page {
  min-height: 100vh;
  background: #f5f5f7;
}

/* 分类标签 */
.tabs-scroll {
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #d2d2d7;
}

.tabs {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.tab {
  padding: 12rpx 28rpx;
  border-radius: 980rpx;
  font-size: 26rpx;
  color: #1d1d1f;
  background: #e8e8ed;
  white-space: nowrap;
  font-weight: 500;
}

.tab.active {
  background: #1d1d1f;
  color: #fff;
}

/* 商家列表 */
.merchant-list {
  padding: 24rpx;
}

.merchant-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

.merchant-card:active {
  background: #fafafa;
}

.merchant-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.merchant-initial {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.merchant-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.merchant-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-area {
  display: block;
  font-size: 26rpx;
  color: #86868b;
  margin-bottom: 10rpx;
}

.merchant-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-hot {
  background: #fff0ec;
  color: #ff3b30;
}

.tag-recommend {
  background: #e8f8f0;
  color: #34c759;
}

.tag-new {
  background: #fff8ec;
  color: #ff9500;
}

.sales {
  font-size: 24rpx;
  color: #aeaeb2;
}

.merchant-arrow {
  color: #aeaeb2;
  font-size: 36rpx;
  margin-left: 16rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #86868b;
}
