.page{min-height:100vh;background:#f5f5f7;padding-bottom:120rpx}.cats{background:#fff;padding:16rpx 24rpx;border-bottom:1rpx solid #d2d2d7}.cats scroll-view{white-space:nowrap}.cat{display:inline-block;padding:10rpx 28rpx;border-radius:980rpx;font-size:24rpx;background:#e8e8ed;color:#1d1d1f;margin-right:12rpx;font-weight:500}.cat.active{background:#1d1d1f;color:#fff}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;padding:20rpx 24rpx}.item{background:#fff;border-radius:16rpx;overflow:hidden}.item:active{opacity:0.95}.item-img{height:200rpx;background:#e8e8ed;display:flex;align-items:center;justify-content:center}.item-emoji{font-size:60rpx;opacity:0.6}.item-body{padding:16rpx}.item-title{display:block;font-size:26rpx;font-weight:600;color:#1d1d1f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.item-price{display:block;font-size:30rpx;font-weight:700;color:#ff3b30;margin-top:6rpx}.item-meta{display:block;font-size:20rpx;color:#86868b;margin-top:4rpx}.empty{text-align:center;padding:120rpx 0;color:#86868b;font-size:28rpx}.fab{position:fixed;bottom:40rpx;right:32rpx;width:100rpx;height:100rpx;border-radius:50rpx;background:#0071e3;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 24rpx rgba(0,113,227,0.3);z-index:100}.fab text{font-size:48rpx;color:#fff;font-weight:300}.fab:active{opacity:0.8}
