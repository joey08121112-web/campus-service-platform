<view class="page">
  <view class="cats">
    <scroll-view scroll-x>
      <view class="cat {{cat===''?'active':''}}" bindtap="setCat" data-v="">全部</view>
      <view class="cat {{cat==='数码'?'active':''}}" bindtap="setCat" data-v="数码">数码</view>
      <view class="cat {{cat==='书籍'?'active':''}}" bindtap="setCat" data-v="书籍">书籍</view>
      <view class="cat {{cat==='生活'?'active':''}}" bindtap="setCat" data-v="生活">生活</view>
      <view class="cat {{cat==='服装'?'active':''}}" bindtap="setCat" data-v="服装">服装</view>
    </scroll-view>
  </view>
  <view class="grid">
    <view class="item" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="item-img"><text class="item-emoji">📦</text></view>
      <view class="item-body">
        <text class="item-title">{{item.title}}</text>
        <text class="item-price">¥{{item.price}}</text>
        <text class="item-meta">{{item.condition}} · {{item.seller_name}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{items.length===0}}"><text>暂无闲置商品</text></view>
  <view class="fab" bindtap="goPublish"><text>+</text></view>
</view>
