.page{min-height:100vh;background:#f5f5f7;padding-bottom:120rpx}.cats{background:#fff;padding:16rpx 24rpx;border-bottom:1rpx solid #d2d2d7}.cats scroll-view{white-space:nowrap}.cat{display:inline-block;padding:10rpx 28rpx;border-radius:980rpx;font-size:24rpx;background:#e8e8ed;color:#1d1d1f;margin-right:12rpx;font-weight:500}.cat.active{background:#1d1d1f;color:#fff}.list{padding:20rpx 24rpx}.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}.card:active{background:#fafafa}.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}.card-title{font-size:30rpx;font-weight:600;color:#1d1d1f}.card-salary{font-size:28rpx;font-weight:700;color:#ff3b30}.card-desc{font-size:26rpx;color:#86868b;margin-bottom:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.card-foot{display:flex;gap:20rpx;padding-top:12rpx;border-top:1rpx solid #d2d2d7}.card-loc,.card-time{font-size:22rpx;color:#86868b}.empty{text-align:center;padding:120rpx 0;color:#86868b;font-size:28rpx}.fab{position:fixed;bottom:40rpx;right:32rpx;width:100rpx;height:100rpx;border-radius:50rpx;background:#0071e3;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 24rpx rgba(0,113,227,0.3);z-index:100}.fab text{font-size:48rpx;color:#fff;font-weight:300}.fab:active{opacity:0.8}
