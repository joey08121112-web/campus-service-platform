.page{min-height:100vh;background:#f5f5f7;padding:20rpx 24rpx}.form-card{background:#fff;border-radius:16rpx;overflow:hidden;margin-bottom:20rpx}.input-row{display:flex;align-items:center;padding:24rpx 28rpx;border-bottom:1rpx solid #d2d2d7}.input-row:last-child{border-bottom:none}.label{width:100rpx;font-size:28rpx;color:#1d1d1f;flex-shrink:0}.input{flex:1;font-size:28rpx;color:#1d1d1f}.chips{display:flex;gap:12rpx;flex:1}.chip{padding:10rpx 24rpx;border-radius:980rpx;font-size:24rpx;background:#e8e8ed;color:#1d1d1f}.chip.active{background:#1d1d1f;color:#fff}.btn{background:#0071e3;color:#fff;border-radius:16rpx;padding:28rpx;text-align:center;font-size:30rpx;font-weight:600;margin-top:20rpx}.btn:active{background:#0077ed}
