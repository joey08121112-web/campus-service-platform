/* ============================================
   校园综合服务 · Apple Store 风格
   ============================================ */

page {
  --bg: #f5f5f7;
  --card: #ffffff;
  --text: #1d1d1f;
  --text-secondary: #86868b;
  --text-tertiary: #aeaeb2;
  --link: #0066cc;
  --accent: #0071e3;
  --accent-hover: #0077ed;
  --divider: #d2d2d7;
  --shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  --radius: 18rpx;
  --radius-lg: 28rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Helvetica Neue', sans-serif;
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 0;
}

/* 大标题 */
.heading-large {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text);
}

.heading-medium {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--text);
}

.heading-small {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

/* 链接 */
.link {
  color: var(--link);
  font-size: 28rpx;
}

.link:active {
  opacity: 0.7;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.card-body {
  padding: 28rpx;
}

/* 列表组 */
.list-group {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  margin: 24rpx 0;
}

.list-row {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
}

.list-row:last-child {
  border-bottom: none;
}

.list-row:active {
  background: #f5f5f7;
}

.list-row-content {
  flex: 1;
}

.list-row-label {
  font-size: 30rpx;
  color: var(--text);
}

.list-row-value {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.list-row-arrow {
  color: var(--text-tertiary);
  font-size: 32rpx;
  margin-left: 16rpx;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 980rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

.btn-blue {
  background: var(--accent);
  color: #fff;
}

.btn-blue:active {
  background: var(--accent-hover);
}

.btn-gray {
  background: #e8e8ed;
  color: var(--text);
}

.btn-gray:active {
  background: #d2d2d7;
}

.btn-sm {
  height: 56rpx;
  padding: 0 32rpx;
  font-size: 24rpx;
}

.btn-md {
  height: 72rpx;
  padding: 0 48rpx;
  font-size: 28rpx;
}

.btn-lg {
  height: 88rpx;
  padding: 0 64rpx;
  font-size: 30rpx;
}

/* 输入框 */
.input-group {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  margin: 24rpx 0;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
}

.input-row:last-child {
  border-bottom: none;
}

.input-label {
  width: 140rpx;
  font-size: 30rpx;
  color: var(--text);
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.input-placeholder {
  color: var(--text-tertiary);
}

/* 标签 */
.chip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 980rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #e8e8ed;
  color: var(--text);
}

.chip.active {
  background: var(--text);
  color: #fff;
}

/* 分割标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 40rpx 32rpx 20rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text);
}

.section-link {
  font-size: 28rpx;
  color: var(--link);
}

/* 安全区 */
.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
